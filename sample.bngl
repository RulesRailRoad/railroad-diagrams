begin molecule types
    egf(r)
    egfr(l,r,Y1068~Y~pY,Y1148~Y~pY)
    Shc(PTB,Y317~Y~pY)
    Grb2(SH2,SH3)
    Sos(dom)
end molecule types

begin seed species
    egf(r)                        egf_tot
    Grb2(SH2,SH3)                 Grb2_tot
    Shc(PTB,Y317~Y)               Shc_tot
    Sos(dom)                      Sos_tot
    egfr(l,r,Y1068~Y,Y1148~Y)     egfr_tot
    Grb2(SH2,SH3!1).Sos(dom!1)    Grb2_Sos_tot
end seed species

begin reaction rules
    # Ligand-receptor binding      
    egfr(l!-,r!-,Y1068~Y~pY!?,Y1148~Y~pY!?)   + egf(r!-) <-> egfr(l!1,r!-,Y1068~Y~pY!?,Y1148~Y~pY!?).egf(r!1)  kp1, km1   #ligand-monomer

    # Note changed multiplicity
    # Receptor-aggregation 
    egfr(l!+,r!-,Y1068~Y~pY!?,Y1148~Y~pY!?) + egfr(l!+,r!-,Y1068~Y~pY!?,Y1148~Y~pY!?) <-> egfr(l!+,r!3,Y1068~Y~pY!?,Y1148~Y~pY!?).egfr(l!+,r!3,Y1068~Y~pY!?,Y1148~Y~pY!?)  kp2,km2
    egfr(l!+,r!-,Y1068~Y!?,Y1148~Y~pY!?) + egfr(l!+,r!-,Y1068~Y~pY!?,Y1148~Y~pY!?) <-> egfr(l!+,r!3,Y1068~pY!?,Y1148~Y~pY!?).egfr(l!+,r!3,Y1068~Y~pY!?,Y1148~Y~pY!?)  kp2,km2

    # Transphosphorylation of egfr by RTK
    egfr(l!?, r!+,Y1068~Y!-, Y1148~Y~pY!?) -> egfr(l!?, r!+,Y1068~pY!-, Y1148~Y~pY!?)  kp3
    egfr(l!?, r!+,Y1068~Y~pY!?, Y1148~Y!-) ->  egfr(l!?, r!+,Y1068~Y~pY!?, Y1148~pY!-)  kp3

    #Dephosphorylayion
    egfr(l!?, r!+,Y1068~pY!-, Y1148~Y~pY!?) -> egfr(l!?, r!+,Y1068~Y!-, Y1148~Y~pY!?)  km3
    egfr(l!?, r!+,Y1068~Y~pY!?, Y1148~pY!-) -> egfr(l!?, r!+,Y1068~Y~pY!?, Y1148~Y!-)  km3

    # Shc transphosph
    egfr(l!?,r!+,Y1068~Y~pY!?,Y1148~pY!1).Shc(PTB!1,Y317~Y!-) ->  egfr(l!?,r!+,Y1068~Y~pY!?,Y1148~pY!1).Shc(PTB!1,Y317~pY!-)  kp14
    Shc(PTB!+,Y317~pY!-)  ->  Shc(PTB!+,Y317~Y!-)  km14

end reaction rules

begin observables
    Molecules    Dimers       egfr(l!?,r!?,Y1068~Y~pY!?,Y1148~Y~pY!?).egfr(l!?,r!?,Y1068~Y~pY!?,Y1148~Y~pY!?)
    Molecules    Sos_act      Shc(PTB!+,Y317~pY!2).Grb2(SH2!2,SH3!3).Sos(dom!3), egfr(Y1068~pY!1).Grb2(SH2!1,SH3!2).Sos(dom!2)
    Molecules    RP           egfr(l!?,r!?,Y1068~Y~pY!?,Y1148~pY!?), egfr(l!?,r!?,Y1068~pY!?,Y1148~Y~pY!?)

    Molecules    Efgr_total   egfr(l!?,r!?,Y1068~Y~pY!?,Y1148~Y~pY!?)
end observables
end model
